# ============================================================
# SYNEX420 HIMS v3 — Vercel Environment Variables
# Add ALL of these in: Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# MongoDB Atlas connection string
# Get from: Atlas → Database → Connect → Drivers → copy the string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/synex420?retryWrites=true&w=majority&appName=Synex420

# Database name (keep as synex420)
MONGODB_DB=synex420

# JWT Secret — must be long and random (48+ characters)
# Generate one at: https://generate-secret.vercel.app/48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING

# Your deployed Vercel URL (set after first deploy)
# Example: https://synex420.vercel.app
CLIENT_URL=https://YOUR-APP.vercel.app
