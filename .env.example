# ============================================================
# SYNEX420 HIMS v3 — Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── MongoDB Atlas ────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/synex420?retryWrites=true&w=majority&appName=Synex420
MONGODB_DB=synex420

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_48_CHARS

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Frontend (Vite) ──────────────────────────────────────────
# In development: http://localhost:4000
# In production: your Vercel/Railway/Render API URL
VITE_API_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
